# Postgres connection string.
# Local (docker compose): postgresql://postgres:postgres@localhost:5432/blog_inventory
# Neon: postgresql://USER:PASSWORD@HOST.neon.tech/DB?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/blog_inventory

# Secret used to sign the session JWT. Generate with: openssl rand -base64 32
SESSION_SECRET=replace-me-with-a-32-byte-random-string

# Optional: seed the demo admin account with this password (defaults to "demo1234")
SEED_ADMIN_PASSWORD=
